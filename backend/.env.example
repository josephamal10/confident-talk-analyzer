# Copy this file to backend/.env and fill in what you use. backend/.env is git-ignored.

# --- AI coach (LLM) -------------------------------------------------------
# Free-tier API key from https://console.groq.com/keys
GROQ_API_KEY=

# Optional: pick a provider explicitly (groq, gemini, ollama, or none to disable the coach).
# Without it, the first provider whose API key is set is used.
# LLM_PROVIDER=groq
# GEMINI_API_KEY=
# LLM_MODEL=openai/gpt-oss-120b
# LLM_BASE_URL=            # any other OpenAI-compatible server

# --- Speech models --------------------------------------------------------
# WHISPER_MODEL=small.en   # base.en is faster, small.en is more accurate
# EMOTION_MODEL_PATH=models/emotion-w2v2-int8.onnx

# --- Server ---------------------------------------------------------------
# SECRET_KEY=              # set in production; otherwise a key is generated in backend/.secret_key
# DATABASE_PATH=app_data.db
# UPLOAD_FOLDER=uploads
